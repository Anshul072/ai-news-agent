# Required — powers all three agents (news parse, sentiment, RAG)
GROQ_API_KEY=      # llama-3.3-70b-versatile

# Optional — only needed to run the eval harness under eval/ (LLM-as-judge)
GEMINI_API_KEY=    # gemini flash, used as the eval judge only — not by the app

# Note: Hacker News community sentiment uses the public Algolia API and needs
# no credentials. Embeddings run locally via fastembed (ONNX) — no API key.

# Optional — comma-separated RSS feed URLs (defaults to curated high-signal AI sources)
RSS_FEEDS=https://export.arxiv.org/rss/cs.AI,https://export.arxiv.org/rss/cs.LG,https://openai.com/news/rss.xml,https://www.anthropic.com/rss.xml,https://deepmind.google/blog/rss.xml,https://ai.meta.com/blog/rss/,https://mistral.ai/news/feed/,https://arstechnica.com/ai/feed/,https://www.theverge.com/rss/tech/index.xml,https://www.deeplearning.ai/the-batch/feed/,https://importai.substack.com/feed

# Optional — APScheduler cron expressions
NEWS_SCHEDULE=0 23 * * 1,3,5
SENTIMENT_SCHEDULE=0 8 * * *

# Optional — story clustering cosine-similarity threshold (0–1)
CLUSTERING_THRESHOLD=0.75

# Optional — article relevance filter threshold (0–1); articles below this are skipped
ARTICLE_FILTER_THRESHOLD=0.5

# Optional — rolling window for sentiment re-scans (days)
SENTIMENT_WINDOW_DAYS=7

# Optional — max concurrent workers for the LLM-bound parse step
PARSE_MAX_WORKERS=5

# Optional — cap ONNX Runtime threads for embeddings so a large batch can't
# starve the in-process Streamlit UI thread (defaults to ~half the cores, max 4)
# EMBED_TORCH_THREADS=4

# Optional — persistent cache dir for the fastembed model
# (defaults to ~/.cache/fastembed; avoids the OS temp dir being wiped on cleanup)
# EMBED_CACHE_DIR=
</content>
